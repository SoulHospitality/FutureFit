generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  customer
  ops
  admin
}

enum ProductType {
  boxers
  briefs
  trunks
  undershirt
  socks
  bundle
}

enum Audience {
  men
  women
  kids
}

enum ProductStatus {
  active
  draft
}

enum OrderStatus {
  pending
  confirmed
  out_for_delivery
  delivered
  canceled
  problem
}

enum ProblemStatus {
  open
  in_progress
  resolved
  closed
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(customer)
  phone        String?
  address      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders           Order[]
  problemRequests  ProblemRequest[] @relation("CustomerProblems")
  createdProblems  ProblemRequest[] @relation("CreatedProblems")
}

model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String
  audience  Audience
  parentId  String?
  /// Cover image for homepage Departments (root categories).
  imageUrl  String?
  /// Short line shown under the name on homepage Departments.
  statement String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([audience, slug])
  @@index([audience])
  @@index([parentId])
}

model Product {
  id           String        @id @default(uuid())
  name         String
  description  String
  price        Decimal       @db.Decimal(10, 2)
  type         ProductType
  audience     Audience      @default(men)
  status       ProductStatus @default(active)
  categoryId   String?
  photos       String[]
  colors       String[]
  /// Optional map of colour name → photo URL(s). Values may be a string or string[].
  photoByColor Json?
  sizes        String[]      @default([])
  stock        Int           @default(0)
  isSaleActive Boolean       @default(false)
  salePrice    Decimal?      @db.Decimal(10, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  category   Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sizeStocks ProductSize[]
  orderItems OrderItem[]
  reviews    Review[]

  @@index([audience])
  @@index([categoryId])
  @@index([status])
}

model Review {
  id        String   @id @default(uuid())
  productId String
  name      String
  rating    Int
  comment   String
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSize {
  id        String  @id @default(uuid())
  productId String
  size      String
  stock     Int     @default(0)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size])
  @@index([productId])
}

model Slide {
  id            String   @id @default(uuid())
  cloudinaryUrl String
  title         String   @default("New Arrival")
  description   String   @default("Shop the collection")
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Coupon {
  id                 String   @id @default(uuid())
  code               String   @unique
  discountPercentage Int
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orders Order[]
}

model Order {
  id              String      @id @default(uuid())
  userId          String?
  guestName       String?
  guestPhone      String?
  guestEmail      String?
  status          OrderStatus @default(pending)
  paymentMethod   String
  shippingAddress Json
  itemsPrice      Decimal     @db.Decimal(10, 2)
  shippingPrice   Decimal     @db.Decimal(10, 2) @default(0)
  discountAmount  Decimal     @db.Decimal(10, 2) @default(0)
  totalPrice      Decimal     @db.Decimal(10, 2)
  couponId        String?
  couponCode      String?
  isPaid          Boolean     @default(false)
  paidAt          DateTime?
  deliveredAt     DateTime?
  /// Paymob Intention / transaction refs (card & wallet checkout)
  paymobIntentionId   String?
  paymobTransactionId String?  @unique
  /// Bosta shipment refs
  bostaDeliveryId     String?
  bostaTrackingNumber String?
  shippingCarrier     String?
  shippingStatus      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user     User?         @relation(fields: [userId], references: [id])
  coupon   Coupon?       @relation(fields: [couponId], references: [id])
  items    OrderItem[]
  problems ProblemRequest[]

  @@index([bostaTrackingNumber])
  @@index([paymobIntentionId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  name      String
  qty       Int
  image     String
  price     Decimal @db.Decimal(10, 2)
  color     String?
  size      String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model ProblemRequest {
  id          String        @id @default(uuid())
  orderId     String
  customerId  String
  createdById String
  subject     String
  details     String
  status      ProblemStatus @default(open)
  resolution  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer  User  @relation("CustomerProblems", fields: [customerId], references: [id])
  createdBy User  @relation("CreatedProblems", fields: [createdById], references: [id])
}

model SiteAsset {
  id            String   @id @default(uuid())
  key           String   @unique
  cloudinaryUrl String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/** Staff-tracked operating costs for finance P&L (cash basis). */
model Expense {
  id          String   @id @default(uuid())
  category    String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  expenseDate DateTime
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expenseDate])
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
}

/** Incomplete checkouts for staff recovery (Shopify-style abandoned checkouts). */
model AbandonedCheckout {
  id               String   @id @default(uuid())
  sessionKey       String   @unique
  userId           String?
  guestName        String?
  guestPhone       String?
  guestEmail       String?
  shippingAddress  Json?
  cartItems        Json
  subtotal         Decimal  @db.Decimal(10, 2) @default(0)
  lastStep         String   @default("contact")
  recoveryStatus   String   @default("not_recovered") // not_recovered | recovered | completed
  completedOrderId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  completedAt      DateTime?

  @@index([recoveryStatus])
  @@index([updatedAt])
}

/** Lightweight storefront presence for Live View (last 5 minutes = "right now"). */
model StorePresence {
  id         String   @id @default(uuid())
  sessionKey String
  path       String?
  city       String?
  country    String?  @default("Egypt")
  lat        Float?
  lng        Float?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([sessionKey])
  @@index([lastSeenAt])
}
