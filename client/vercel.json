{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://futurefit-production-2a44.up.railway.app/api/marketing/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://futurefit-production-2a44.up.railway.app/api/marketing/robots.txt"
    },
    {
      "source": "/feeds/products.xml",
      "destination": "https://futurefit-production-2a44.up.railway.app/api/marketing/feed.xml"
    },
    {
      "source": "/:name([A-Za-z0-9_-]+\\.(?:html|txt|xml))",
      "destination": "https://futurefit-production-2a44.up.railway.app/api/marketing/verify/:name"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
