# Railway API — set this on Vercel as:
#   Name:  VITE_API_URL
#   Value: https://futurefit-production-2a44.up.railway.app/api
# Do NOT put "VITE_API_URL=" inside the value field.
VITE_API_URL=

# Optional — shown on checkout & order success when set
VITE_INSTAPAY_HANDLE=

# Meta (Facebook) Pixel — Events Manager Pixel ID
# Also set on Vercel for production builds
VITE_META_PIXEL_ID=484242591335280

# Optional — shown on Contact page / footer (defaults baked in for FutureFit)
VITE_CONTACT_EMAIL=online@futurefits.net
VITE_CONTACT_PHONE=+20 101 164 8029
VITE_WHATSAPP_NUMBER=201011648029
